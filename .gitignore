.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_dir.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

