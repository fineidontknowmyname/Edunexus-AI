.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, WebStorm, IntelliJ, etc.)
.idea/

# Sublime Text / Vim
*.swp
*.swo
*.sublime-project
*.sublime-workspace

