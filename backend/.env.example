# Database (PostgreSQL with the pgvector extension is required; there is no SQLite fallback)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/edunexus

# LLM / AI
GROQ_API_KEY=your-groq-api-key-here
LLM_PROVIDER=groq
OLLAMA_BASE_URL=http://localhost:11434
GROQ_PRIMARY_MODEL=openai/gpt-oss-20b
GROQ_SECONDARY_MODEL=openai/gpt-oss-120b
YOUTUBE_API_KEY=

# Auth (in production JWT_SECRET must be a random value of at least 32 characters or the app refuses to start)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Runtime
ENVIRONMENT=development
# Comma-separated list of allowed browser origins. With the Vercel rewrite the app is same-origin, so this is a fallback.
CORS_ORIGINS=http://localhost:3000

# Document ingestion
RUN_INGESTION_IN_PROCESS=true
INGESTION_POLL_INTERVAL_SECONDS=300
MAX_UPLOAD_MB=20
