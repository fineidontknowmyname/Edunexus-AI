# Database
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/edunexus

# LLM / AI
GROQ_API_KEY=your-groq-api-key-here
LLM_PROVIDER=groq
OLLAMA_BASE_URL=http://localhost:11434
GROQ_PRIMARY_MODEL=openai/gpt-oss-20b
GROQ_SECONDARY_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE_HOURS=24

# Runtime
ENVIRONMENT=development
# Comma-separated list of allowed frontend origins (add your Vercel URL in production)
CORS_ORIGINS=http://localhost:3000
